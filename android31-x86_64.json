{
    "emulator_package": "system-images;android-31;google_apis;x86_64",
    "emulator_avd_name": "mozemulator-android31-x86_64",
    "emulator_extra_args": [
        "-skip-adb-auth",
        "-selinux", "permissive",
        "-memory", "8192",
        "-cores", "4",
        "-skin", "1280x960",
        "-no-audio",
        "-no-window",
        "-no-boot-anim",
        "-no-snapstorage",
        "-qemu", "-enable-kvm", "-cpu", "host", "-smp", "cores=4"
    ],
    "emulator_extra_config": {
        "hw.keyboard": "yes",
        "hw.lcd.density": "320"
    }
}
